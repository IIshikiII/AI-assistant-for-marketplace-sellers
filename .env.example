# Скопируйте в .env и заполните. Файл .env в git не попадает.

APP_ENV=local
LOG_LEVEL=INFO

# DeepSeek (OpenAI-совместимый API): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Локально приложение ходит в Postgres из docker compose на localhost.
# В контейнере compose сам подставляет хост db.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/app
